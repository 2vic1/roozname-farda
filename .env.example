# ============================================================
# روزنامه فردا — Environment variables
# Copy this file to `.env` and fill in your values
# ============================================================

# --- Database (Prisma + SQLite) ---
# Path to the SQLite database file
DATABASE_URL=file:./db/custom.db

# --- AI Gateway (optional) ---
# Your own OpenAI-compatible API key.
# If set, all AI features (risk analysis, forecasts, news translation)
# use YOUR key. If empty, the built-in sandbox fallback is used.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# --- Telegram Bot (optional — only for telegram-app/vps/bot.mjs) ---
# Get a token from @BotFather, then run the bot with these env vars.
TELEGRAM_BOT_TOKEN=
# Telegram numeric chat ID allowed to use admin commands (/setkey ...)
ADMIN_CHAT_ID=
# Public HTTPS URL of the Mini App button (e.g. https://your-domain)
MINIAPP_URL=
